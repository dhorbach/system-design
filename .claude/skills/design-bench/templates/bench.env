# Copy to bench/<slug>/bench.env. Fill the CPU sets and the device from
# `python3 .claude/skills/design-bench/scripts/preflight.py`.
SLUG=todo-slug

# Disjoint CPU sets. What is measured never shares a CPU with what measures it.
CPUS_SUT=0-9
CPUS_DATA=10-15
CPUS_AUX=16-22
CPUS_LOAD=24-31
CPUS_MON=23

# Block device behind Docker's volumes, for disk limits.
DATA_DEVICE=/dev/nvme0n1

# Host ports. Change them if another bench is up.
TOXI_PORT=8474
SINK_PORT=8090

# 1 = real time. 60 = one bench minute stands for one design hour (see reference/bench.md, "Time").
CLOCK_SCALE=1
